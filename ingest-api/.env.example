# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# MongoDB connection string (Atlas or self-managed).
MONGODB_URI=mongodb://127.0.0.1:27017/jobs

# Shared secret for internal APIs. Sent as: Authorization: Bearer <key>
INGEST_API_KEY=change-me

# Max jobs accepted per POST /internal/jobs/ingest request.
MAX_INGEST_BATCH_SIZE=500

# Search backend: atlas (strict, fails clearly if unavailable),
# text (traditional text-index fallback), or auto (try atlas, fall back to text).
MONGODB_SEARCH_MODE=atlas

# Name of the Atlas Search index defined in search-index/jobs-search-index.json.
MONGODB_SEARCH_INDEX_NAME=jobs_search

# JSON body limit for ingest batches (~500 jobs fit comfortably in 2mb).
JSON_BODY_LIMIT=2mb
